# Build environment for the remoteDisplay receiver image.
# Same Debian release as the image itself, so the receiver is linked against the
# glibc / SDL2 it will run with.
#
# Built twice by scripts/build.sh:
#   - linux/amd64 for receiver_app (must be an x86-64 binary);
#   - the host's native platform for mkosi + packing. mkosi cannot run under
#     user-mode x86 emulation (it needs mount_setattr()), so on an Apple Silicon
#     host the x86-64 root tree is assembled natively and its foreign binaries run
#     through qemu-user.
# Pinned by digest (the multi-arch index, so it resolves on arm64 and amd64 hosts alike). To update:
#   docker buildx imagetools inspect debian:trixie    # copy the "Digest:" line
FROM debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308

ENV DEBIAN_FRONTEND=noninteractive

# Builder packages (mkosi, grub, qemu...) come from the same snapshot.debian.org snapshot as the
# image (scripts/build.sh passes image/SNAPSHOT). Plain http: the base image has no CA bundle yet,
# apt verifies the archive signatures anyway.
# The pinned base image already carries security updates that the main snapshot predates, and the
# snapshot's -dev packages depend on exact versions: trixie-security is therefore pinned too, to a
# debian-security snapshot taken after the base image (the two archives have separate ids).
# Refresh both together with the digest above.
ARG SNAPSHOT=
ARG SECURITY_SNAPSHOT=20261024T115256Z
RUN if [ -n "$SNAPSHOT" ]; then \
        printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$SNAPSHOT" "$SECURITY_SNAPSHOT" \
            > /etc/apt/sources.list.d/debian.sources; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends \
        mkosi bubblewrap debootstrap apt dpkg-dev debian-archive-keyring ca-certificates \
        systemd-container kmod python3 git qemu-user-static \
        squashfs-tools dosfstools mtools fdisk zstd \
        grub-common qemu-system-x86 ovmf \
        cmake g++ make pkg-config libsdl2-dev \
    && rm -rf /var/lib/apt/lists/*

# grub-efi-amd64-bin only exists for amd64 hosts: fetch the x86_64-efi modules
# explicitly so grub-mkstandalone works on any build host.
RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && cd /tmp && apt-get download grub-efi-amd64-bin:amd64 \
    && dpkg -x grub-efi-amd64-bin_*.deb /opt/grub-amd64 \
    && rm -f /tmp/*.deb && rm -rf /var/lib/apt/lists/*

WORKDIR /work/image
