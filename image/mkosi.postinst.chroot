#!/bin/sh
# Runs inside the image root after packages are installed.
set -eu

systemctl enable systemd-networkd.service nftables.service rd-helper.service

# No local login on the panel: tty1 belongs to the receiver (see rd-helper.service).
systemctl mask getty@tty1.service getty-static.service
# Nothing to sync with: the only network is the Thunderbolt link to the Mac.
systemctl mask systemd-timesyncd.service apt-daily.timer apt-daily-upgrade.timer \
    e2scrub_all.timer fstrim.timer 2>/dev/null || true

# /etc/machine-id is "uninitialized", so systemd treats every boot as a first boot and runs the
# First Boot Wizard, which asks for locale, keymap, timezone and a root password on the console
# and blocks boot until someone answers. This is an appliance: never ask.
systemctl mask systemd-firstboot.service

systemctl set-default multi-user.target

# Dev profile only (marker file shipped by mkosi.profiles/dev).
if [ -e /etc/remotedisplay-dev ]; then
    systemctl enable ssh.service serial-getty@ttyS0.service rd-doctor-console.service
    chmod 700 /root/.ssh
    [ -f /root/.ssh/authorized_keys ] && chmod 600 /root/.ssh/authorized_keys
fi

# The journal is volatile (journald.conf.d). Package scripts may leave an empty
# /var/log/journal/<machine-id> behind when they run natively: drop it.
rm -rf /var/log/journal

echo remotedisplay > /etc/hostname
# Lock root (no password login). Not `passwd -l`: the release profile has no passwd binary and
# possibly no /etc/shadow either. A "*" in /etc/passwd locks the account whatever shadow says.
sed -i 's/^root:[^:]*:/root:*:/' /etc/passwd
[ ! -f /etc/shadow ] || sed -i 's/^root:[^:]*:/root:*:/' /etc/shadow
grep -q '^root:\*:' /etc/passwd

# The initramfs is generated before our config is copied in: rebuild it.
update-initramfs -u -k all

# Reproducible builds: logs written by package scripts during the build hold the build's timestamps,
# and are useless on a RAM-only appliance (journald is volatile).
rm -rf /var/log/alternatives.log /var/log/dpkg.log /var/log/bootstrap.log /var/log/fontconfig.log \
    /var/log/apt
