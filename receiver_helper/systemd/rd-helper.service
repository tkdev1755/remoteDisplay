[Unit]
Description=remoteDisplay — helper headless du récepteur (KMS/DRM)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
# On veut la console libre : pas de display manager.
Conflicts=gdm.service getty@tty1.service

[Service]
Type=simple
# Adapter les chemins à l'installation réelle :
ExecStart=/opt/remotedisplay/rd_helper --receiver /opt/remotedisplay/receiver_app
Environment=SDL_VIDEODRIVER=kmsdrm

# Le receiver (enfant) doit être DRM master : sans session logind, il faut root.
User=root

# Donne au receiver une console à lui pour le KMS (évite les warnings "no VT").
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
