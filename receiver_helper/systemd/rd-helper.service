[Unit]
Description=remoteDisplay — headless receiver daemon (KMS/DRM)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
# The console must be free: no display manager.
Conflicts=gdm.service getty@tty1.service

[Service]
Type=simple
# Adjust the paths to the actual installation:
ExecStart=/opt/remotedisplay/rd_helper --receiver /opt/remotedisplay/receiver_app
Environment=SDL_VIDEODRIVER=kmsdrm

# The (child) receiver must be DRM master: without a logind session, this requires root.
User=root

# Gives the receiver its own console for KMS (avoids "no VT" warnings).
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
